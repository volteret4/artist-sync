# Copia este fichero a .env y rellénalo. Los valores vacíos son obligatorios u opcionales según el README.

# Versión de API Subsonic a declarar (ej. 1.15.0) — súbela solo si tu Airsonic la soporta; una versión mas nueva que la suya da 'Incompatible Airsonic REST protocol version' (aunque esto ya se autodetecta solo en el siguiente sync)
AIRSONIC_API_VERSION=1.15.0
# Contraseña Airsonic
AIRSONIC_PASSWORD=
# URL base de Airsonic
AIRSONIC_URL=http://localhost:4040
# Usuario Airsonic
AIRSONIC_USER=admin
# Ruta host donde qBittorrent guarda las descargas, montada en /mnt/music/qbittorrent dentro de este contenedor (bind mount — requiere recrear el contenedor)
ARTIST_SYNC_QB_MUSIC_PATH=
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# API key de Last.fm — solo hace falta si NO hay espejo compartido (lastfm_data) montado
LASTFM_API_KEY=
# Umbral minimo de scrobbles al escanear (el filtro fino se ajusta luego en la web)
LASTFM_MIN_PLAYCOUNT=5
LASTFM_SCROBBLES_DB=/data/lastfm_stats.db
# Usuario de Last.fm — solo hace falta si NO hay espejo compartido (lastfm_data) montado
LASTFM_USERNAME=
# Email de contacto para la API de MusicBrainz (lo piden en el User-Agent)
MB_EMAIL=admin@localhost
# Contraseña de Muspy
MUSPY_PASSWORD=
# Usuario de Muspy
MUSPY_USERNAME=
# Categoria de qBittorrent a escanear (vacio = todos los torrents)
QB_CATEGORY=
# Host/IP de qBittorrent
QB_HOST=localhost
# Contraseña WebUI de qBittorrent
QB_PASS=
# Puerto WebUI de qBittorrent
QB_PORT=8080
# Solo si qBittorrent corre en SU PROPIO contenedor: la ruta tal cual la reporta su API (ej. /downloads). Se reescribe por la ruta local antes de leer los FLAC. Vacío si qBittorrent corre directamente en este mismo host/filesystem
QB_REMOTE_PATH=
# Usuario WebUI de qBittorrent
QB_USER=admin
SETTINGS_PASSWORD=

# ── docker-compose.yml ──────────────────────────────────────────
# Opcional: carpeta de descargas de qBittorrent
QB_MUSICA=./datos/qbittorrent
# Carpeta con lastfm_stats.db de [lastfm_scrobbles](https://github.com/volteret4/lastfm_scrobbles)
LASTFM_DIR=./datos/lastfm
# Uid:gid del usuario dueño de esta carpeta (los ficheros que se generan son suyos)
UID_GID=1000:1000
# Zona horaria de los trabajos programados (Ofelia)
TZ=Europe/Madrid
